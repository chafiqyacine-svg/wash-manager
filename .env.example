# ─── Base de données ────────────────────────────────────────────────────────
POSTGRES_USER=washmanager
POSTGRES_PASSWORD=change-me
POSTGRES_DB=washmanager
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://washmanager:change-me@db:5432/washmanager

# ─── Backend / API ──────────────────────────────────────────────────────────
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Clé secrète JWT — générez avec: openssl rand -hex 32
SECRET_KEY=change-me-with-a-32-byte-hex-key
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Clé partagée entre le pipeline `ai/` et le backend pour signer les événements
AI_INGEST_API_KEY=change-me-ingest-key

# ─── Stockage médias (photos entrée/sortie, captures anomalies) ─────────────
MEDIA_ROOT=/data/media
MEDIA_BASE_URL=http://localhost:8000/media

# ─── Notifications (alertes temps réel + rapport journalier) ────────────────
# TODO(dev): renseigner les identifiants WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_MANAGER_NUMBERS=   # numéros destinataires, séparés par des virgules
REPORT_DAILY_HOUR=21        # heure d'envoi du rapport journalier (0-23)

# ─── Pipeline IA (edge) ─────────────────────────────────────────────────────
BACKEND_EVENTS_URL=http://backend:8000/api/v1/events
# Fichier de configuration des caméras & zones
AI_CONFIG_PATH=ai/config.yaml
